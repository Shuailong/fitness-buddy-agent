# Fitness Buddy web app configuration (copy to web/.env for local development).
# In production (Cloud Run) these are set by Terraform; secrets come from Secret Manager.

# --- Sign-in (FR-13) ---------------------------------------------------------
# OAuth 2.0 Web client ID used by Google Identity Services (public value).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Comma-separated allowlist of Google account e-mails that may sign in.
ALLOWED_EMAILS=you@example.com
# Random key (32+ bytes) that signs the session cookie. REQUIRED on Cloud Run;
# inject it from Secret Manager. Locally, a random per-process key is used if unset.
SESSION_SECRET=
# Session cookie lifetime in seconds (default 7 days).
SESSION_MAX_AGE_SECONDS=604800
# A conversation idle for longer than this starts fresh on the next visit, so the
# coach runs its check-ins again (FR-8). 0 = always reuse the latest conversation.
SESSION_IDLE_HOURS=6
# Local development only: skip Google sign-in and act as user "dev-user".
# Ignored whenever K_SERVICE is set (i.e. on Cloud Run).
DEV_AUTH_BYPASS=false

# --- Agent backend -------------------------------------------------------------
# "local" = ADK API server (uv run uvicorn app.fast_api_app:app --port 8000)
# "agent_runtime" = agent deployed to Agent Runtime (called via the vertexai SDK)
AGENT_BACKEND=local
LOCAL_AGENT_URL=http://localhost:8000
AGENT_APP_NAME=app
AGENT_TIMEOUT_SECONDS=300
# Agent Runtime settings (AGENT_BACKEND=agent_runtime)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
AGENT_RUNTIME_LOCATION=us-east1
AGENT_RUNTIME_RESOURCE=projects/your-project-number/locations/us-east1/reasoningEngines/your-agent-id

# --- Dashboard data (FR-12) ----------------------------------------------------
# "firestore" (default) or "memory" (offline development; empty in a separate process).
FITNESS_STORAGE_BACKEND=firestore
FIRESTORE_DATABASE=(default)

# --- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
# Export OpenTelemetry spans to Cloud Trace.
OTEL_TO_CLOUD=false

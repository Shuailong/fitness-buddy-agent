# Local development configuration for the agent (copy to .env; never commit .env).
# In production these are set by Terraform / `agents-cli deploy --update-env-vars`.

# Gemini platform
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Optional: run Gemini calls in a separate project (defaults to the main project).
# GEMINI_PROJECT=your-gemini-project-id
# GEMINI_LOCATION=global
# Needed only with local user ADC credentials:
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id

# Alternatively, for Gemini API via Google AI Studio,
# comment out the GOOGLE_* lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Storage: "firestore" (default) or "memory" for offline development
FITNESS_STORAGE_BACKEND=memory
# FIRESTORE_DATABASE=(default)

# Model routing (optional overrides)
# COACH_MODEL=gemini-3.8-flash
# NUTRITION_MODEL=gemini-3.8-flash
# PLANNER_MODEL=gemini-3.1-pro-preview
# REVIEWER_MODEL=gemini-3.1-pro-preview
# CRITIC_MODEL=gemini-3.5-flash-lite
# SAFETY_JUDGE_MODEL=gemini-3.5-flash-lite
# SUMMARIZER_MODEL=gemini-3.5-flash-lite

# Guardrails
HEALTH_JUDGE_ENABLED=true
# HEALTH_JUDGE_FAIL_CLOSED=false
MODEL_ARMOR_ENABLED=false
# MODEL_ARMOR_LOCATION=us-east1
# MODEL_ARMOR_TEMPLATE_ID=fitness-buddy-guard

# PII redaction with Cloud DLP (regex redaction is always on)
DLP_ENABLED=false
# DLP_LOCATION=global

# Context management
# COMPACTION_TOKEN_THRESHOLD=48000
# COMPACTION_RETENTION_EVENTS=12
# CONTEXT_CACHE_ENABLED=false
# PLANNER_MAX_CRITIQUE_ROUNDS=2

# Eval runs only: isolate data and memory per session
# FITNESS_EVAL_ISOLATION=true
